{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Analitica": {
    "Generacion": {
      "Habilitada": false
    },
    "Capacidad": {
      "Habilitada": true
    },
    "Entrenamiento": {
      "Habilitada": true
    },
    "Recomendaciones": {
      "Habilitada": true,
      "PorcentajeAumentoDemanda": 30,
      "PorcentajeNoShow": 15,
      "AlertasMensuales": 2
    }
  },
  "Cors": {
    "OrigenesPermitidos": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "GIRA.Api",
    "Audience": "GIRA.Frontend",
    "AccessTokenMinutos": 30,
    "RefreshTokenDias": 7
  }
}
